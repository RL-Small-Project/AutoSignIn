{
	"name": "Ubuntu",
	"image": "mcr.microsoft.com/devcontainers/base:jammy",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/va-h/devcontainers-features/uv:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"donjayamanne.python-extension-pack",
				"charliermarsh.ruff"
			]
		}
	},
	"runArgs": [
		"--network=host"
	],
	"remoteUser": "root"
}